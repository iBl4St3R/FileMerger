<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(NetVersion)-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>FileMerger</AssemblyName>
    <RootNamespace>FileMerger</RootNamespace>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <PropertyGroup Condition="Exists('..\..\resources\icon.ico')">
    <ApplicationIcon>..\..\resources\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="Exists('..\..\resources\icon.ico')">
    <Resource Include="..\..\resources\icon.ico" Link="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileMerger.Core\FileMerger.Core.csproj" />
  </ItemGroup>

</Project>
