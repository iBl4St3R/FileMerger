<Window x:Class="FileMerger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="FileMerger" Width="480" Height="760" MinWidth="380" MinHeight="520"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Background="{DynamicResource WindowBgBrush}" Foreground="{DynamicResource TextBrush}"
        Topmost="{Binding AlwaysOnTop}" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Border BorderBrush="{DynamicResource SurfaceHoverBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" MinHeight="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="120" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="{DynamicResource BarBgBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Image x:Name="TitleIcon" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" />
                    <TextBlock Text="FileMerger" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                    <ToggleButton Style="{StaticResource PinButton}" IsChecked="{Binding AlwaysOnTop}" Content="&#xE718;" ToolTip="Always on top" />
                    <Button Style="{StaticResource TitleButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}" Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- Drop zone -->
            <Grid x:Name="DropZone" Grid.Row="1" Height="90" Margin="10,10,10,8" Background="Transparent" Cursor="Hand" ToolTip="Drop files or folders, click to browse, or press Ctrl+V"
                  DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" MouseLeftButtonUp="DropZone_Click">
                <Border CornerRadius="8" Background="{DynamicResource PanelBgBrush}" IsHitTestVisible="False" />
                <Border CornerRadius="8" IsHitTestVisible="False" Opacity="0.7">
                    <Border.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute" Stretch="None">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="Transparent">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,14,14" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="{DynamicResource SurfaceHoverBrush}">
                                        <GeometryDrawing.Geometry>
                                            <EllipseGeometry Center="7,7" RadiusX="1" RadiusY="1" />
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.Background>
                </Border>
                <Rectangle x:Name="DropBorder" RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="4 3" Stroke="{DynamicResource SurfaceHoverBrush}" IsHitTestVisible="False" />
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock x:Name="DropTitle" Text="Drop files or folders here" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="click to browse · Ctrl+V to paste" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <!-- File list -->
            <Border Grid.Row="2" Margin="10,0" CornerRadius="8" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource SurfaceHoverBrush}" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,4,4,2">
                        <TextBlock Text="{Binding FilesHeader}" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Style="{StaticResource LinkButton}" Content="Clear" HorizontalAlignment="Right" Command="{Binding ClearCommand}" />
                    </Grid>
                    <ListBox x:Name="FileList" ItemsSource="{Binding Items}" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource FileRow}" AllowDrop="True"
                             PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" PreviewMouseMove="FileList_PreviewMouseMove" DragOver="FileList_DragOver" Drop="FileList_Drop" KeyDown="FileList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource RemoveButton}" Content="✕" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding FullPath, Mode=OneWay}">
                                        <Run Text="{Binding Name, Mode=OneWay}" />
                                        <Run Text="{Binding Info, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                    </TextBlock>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Focusable="False" />

            <!-- Preview -->
            <Border Grid.Row="4" Margin="10,0" CornerRadius="8" Padding="2" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource SurfaceHoverBrush}" BorderThickness="1">
                <Grid>
                    <ae:TextEditor x:Name="Preview" Document="{Binding PreviewDocument}" IsReadOnly="True" ShowLineNumbers="True" FontFamily="Consolas" FontSize="12" Padding="4,2,0,0"
                                   Background="{DynamicResource PanelBgBrush}" Foreground="{DynamicResource TextBrush}" LineNumbersForeground="{DynamicResource MutedBrush}"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible" />
                    <TextBlock Text="Merged preview appears here" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <!-- Output -->
            <Grid Grid.Row="5" Margin="10,10,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Name" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" Height="30" Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding AutoName}" ToolTip="{Binding OutputName}" />
                <CheckBox Grid.Column="2" Style="{StaticResource SwitchCheckBox}" Margin="10,0,0,0" Content="Auto-name" IsChecked="{Binding AutoName}" />
                <TextBlock Grid.Row="1" Text="Folder" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,8,10,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Height="30" Margin="0,8,0,0" Text="{Binding OutputFolder, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding OutputFolder}" />
                <Button Grid.Row="1" Grid.Column="2" Margin="10,8,0,0" Height="30" Width="40" HorizontalAlignment="Left" Content="…" ToolTip="Choose destination folder" Click="BrowseFolder_Click" />
            </Grid>

            <!-- Actions -->
            <Grid Grid.Row="6" Margin="10,12,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource SaveButton}" Content="Save" ToolTip="Save merged file (Ctrl+S)" Command="{Binding SaveCommand}" />
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Show file" ToolTip="Show the last saved file in Explorer" Command="{Binding ShowFileCommand}" />
            </Grid>

            <!-- Status bar -->
            <Grid Grid.Row="7" Background="{DynamicResource BarBgBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="10,5" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource InfoBrush}" FontSize="12" Margin="10,5" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusMessage}" />
            </Grid>
        </Grid>
    </Border>
</Window>
