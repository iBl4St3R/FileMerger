<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBgColor">#1E1E2E</Color>
    <Color x:Key="PanelBgColor">#181825</Color>
    <Color x:Key="BarBgColor">#11111B</Color>
    <Color x:Key="SurfaceColor">#313244</Color>
    <Color x:Key="SurfaceHoverColor">#45475A</Color>
    <Color x:Key="TextColor">#CDD6F4</Color>
    <Color x:Key="MutedColor">#6C7086</Color>
    <Color x:Key="AccentColor">#CBA6F7</Color>
    <Color x:Key="InfoColor">#89B4FA</Color>
    <Color x:Key="SaveColor">#1D9E75</Color>
    <Color x:Key="SaveHoverColor">#17865F</Color>
    <Color x:Key="DangerColor">#E24B4A</Color>
    <Color x:Key="SelectionColor">#55CBA6F7</Color>
    <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}" />
    <SolidColorBrush x:Key="BarBgBrush" Color="{StaticResource BarBgColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="SaveBrush" Color="{StaticResource SaveColor}" />
    <SolidColorBrush x:Key="SaveHoverBrush" Color="{StaticResource SaveHoverColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#E24B4A" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="{StaticResource PanelBgColor}" />
</ResourceDictionary>
